# 中央氣象署 (CWA) Open Data API 授權碼
CWA_API_KEY=
# 資料集代碼（預設為全台一週鄉鎮與區域天氣預報 F-A0010-001）
CWA_DATASET_ID=F-A0010-001

# 本機開發 SQLite 資料庫設定 (本機檔案)
DATABASE_URL=file:weather.db
# Vercel 正式環境請填寫 Turso / libSQL 雲端網址與授權 Token:
# DATABASE_URL=libsql://your-database-name.turso.io
DATABASE_AUTH_TOKEN=

# 資料同步端點授權金鑰 (用於 POST /api/weather/sync 與 Vercel Cron)
SYNC_SECRET=
